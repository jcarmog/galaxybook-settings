[Unit]
Description=Samsung Galaxy Book settings service
ConditionPathExists=/sys/bus/platform/drivers/samsung-galaxybook
After=power-profiles-daemon.service

[Service]
Type=dbus
BusName=io.github.galaxybook.Settings1
ExecStart=/usr/libexec/galaxybook-settings/galaxybookd
StateDirectory=galaxybook-settings
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
Restart=on-failure

[Install]
WantedBy=multi-user.target
