[Desktop Entry]
Type=Application
Name=Galaxy Book Settings
Name[pt_BR]=Configurações do Galaxy Book
Comment=Performance mode, battery protection and Samsung hardware features
Comment[pt_BR]=Modo de desempenho, proteção da bateria e recursos de hardware Samsung
Exec=galaxybook-settings
Icon=computer-laptop-symbolic
Terminal=false
Categories=Settings;HardwareSettings;GTK;
Keywords=samsung;galaxy;battery;performance;keyboard;backlight;buds;phone;
StartupNotify=true
Actions=send-files;

[Desktop Action send-files]
Name=Send files to phone
Name[pt_BR]=Enviar arquivos para o celular
Exec=galaxybook-settings --send-files
