#!/usr/bin/env python3
"""Galaxy Book Settings - GTK4/libadwaita front end for galaxybookd, galaxybudsd and galaxyphoned.

Set GALAXYBOOK_BUS=session to talk to a development daemon on the session bus.
"""

import os
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

APP_ID = "io.github.galaxybook.Settings"
BUS_NAME = "io.github.galaxybook.Settings1"
OBJECT_PATH = "/io/github/galaxybook/Settings1"
IFACE = "io.github.galaxybook.Settings1"
BUDS_BUS_NAME = "io.github.galaxybook.Buds1"
BUDS_OBJECT_PATH = "/io/github/galaxybook/Buds1"
BUDS_IFACE = "io.github.galaxybook.Buds1"
PHONE_BUS_NAME = "io.github.galaxybook.Phone1"
PHONE_OBJECT_PATH = "/io/github/galaxybook/Phone1"
PHONE_IFACE = "io.github.galaxybook.Phone1"

# Names Samsung Settings uses on Windows for each platform profile
PROFILE_LABELS = {
    "low-power": ("Power saving", "Lowest power use, reduced performance"),
    "quiet": ("Silent", "Quiet fans and lower temperatures"),
    "balanced": ("Optimized", "Balance performance and battery life"),
    "performance": ("High performance", "Maximum performance, louder fans"),
}
DEFAULT_PROTECTION_LIMIT = 80
BATTERY_DIR = "/sys/class/power_supply/BAT1"

# Names the Galaxy Wearable app uses
NOISE_CONTROL_LABELS = {
    "anc": ("Noise canceling", "Block out background noise"),
    "adaptive": ("Adaptive", "Adjust to your surroundings automatically"),
    "ambient": ("Ambient sound", "Hear your surroundings"),
    "off": ("Off", "No noise control"),
}
EQUALIZER_LABELS = {
    "off": "Normal",
    "bass-boost": "Bass boost",
    "soft": "Soft",
    "dynamic": "Dynamic",
    "clear": "Clear",
    "treble-boost": "Treble boost",
}
PLACEMENT_LABELS = {
    "wearing": "in ear",
    "idle": "out of ear",
    "in-case": "in case",
    "case-closed": "in case",
    "disconnected": "not connected",
}


def read_sysfs(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def call_proxy(proxy, toasts, method, signature, args, on_error=None):
    def done(proxy, result):
        try:
            proxy.call_finish(result)
        except GLib.Error as e:
            Gio.DBusError.strip_remote_error(e)
            toasts.add_toast(Adw.Toast(title=e.message, timeout=5))
            if on_error:
                on_error()

    proxy.call(method, GLib.Variant(signature, args), Gio.DBusCallFlags.NONE, -1, None, done)


def service_unavailable(service):
    return Adw.StatusPage(
        icon_name="dialog-warning-symbolic",
        title="Service not available",
        description=f"The {service} service is not running.\nInstall it with ./install.sh and try again.",
    )


class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app, proxy, buds_proxy, phone_proxy):
        super().__init__(application=app, title="Galaxy Book Settings", default_width=560, default_height=720)
        self.proxy = proxy
        self.updating = False
        self.threshold_timeout = 0

        self.toasts = Adw.ToastOverlay()
        self.stack = stack = Adw.ViewStack()
        header = Adw.HeaderBar(title_widget=Adw.ViewSwitcher(stack=stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(self.toasts)
        self.toasts.set_child(stack)
        self.set_content(toolbar)

        stack.add_titled_with_icon(self.build_laptop_page(), "laptop", "Laptop", "computer-laptop-symbolic")
        buds_page = BudsPage(buds_proxy, self.toasts) if buds_proxy else service_unavailable("galaxybudsd")
        stack.add_titled_with_icon(buds_page, "buds", "Galaxy Buds", "audio-headphones-symbolic")
        self.phone_page = PhonePage(phone_proxy, self.toasts) if phone_proxy else None
        stack.add_titled_with_icon(self.phone_page or service_unavailable("galaxyphoned"), "phone", "Phone",
                                   "phone-symbolic")

    def build_laptop_page(self):
        if self.proxy is None or not self.proxy.get_cached_property_names():
            return service_unavailable("galaxybookd")

        page = Adw.PreferencesPage()
        features = self.prop("Features") or []

        page.add(self.build_device_info())
        if "platform-profile" in features:
            page.add(self.build_performance())
        if "charge-threshold" in features:
            page.add(self.build_battery())
        if "kbd-backlight" in features:
            page.add(self.build_keyboard())
        hw_group = self.build_hardware(features)
        if hw_group:
            page.add(hw_group)

        self.proxy.connect("g-properties-changed", lambda *_: self.sync())
        self.sync()
        GLib.timeout_add_seconds(30, self.refresh_battery_info)
        return page

    # -- helpers ------------------------------------------------------------

    def prop(self, name):
        value = self.proxy.get_cached_property(name)
        return value.unpack() if value is not None else None

    def call(self, method, signature, *args):
        call_proxy(self.proxy, self.toasts, method, signature, args, self.sync)

    # -- sections -----------------------------------------------------------

    def build_device_info(self):
        group = Adw.PreferencesGroup()
        vendor = read_sysfs("/sys/class/dmi/id/sys_vendor", "")
        product = read_sysfs("/sys/class/dmi/id/product_name", "")
        family = read_sysfs("/sys/class/dmi/id/product_family", "")
        title = family if family and "galaxy" in family.lower() else "Galaxy Book"
        self.device_row = Adw.ActionRow(title=title, subtitle=f"{vendor.title()} {product}".strip())
        self.device_row.add_prefix(Gtk.Image(icon_name="computer-laptop-symbolic", pixel_size=32))
        self.battery_label = Gtk.Label(css_classes=["dim-label"], valign=Gtk.Align.CENTER)
        self.device_row.add_suffix(self.battery_label)
        group.add(self.device_row)
        self.refresh_battery_info()
        return group

    def refresh_battery_info(self):
        capacity = read_sysfs(f"{BATTERY_DIR}/capacity")
        full = read_sysfs(f"{BATTERY_DIR}/charge_full") or read_sysfs(f"{BATTERY_DIR}/energy_full")
        design = read_sysfs(f"{BATTERY_DIR}/charge_full_design") or read_sysfs(f"{BATTERY_DIR}/energy_full_design")
        parts = []
        if capacity:
            parts.append(f"{capacity}%")
        if full and design and int(design) > 0:
            parts.append(f"health {min(100, round(100 * int(full) / int(design)))}%")
        self.battery_label.set_label(" · ".join(parts))
        return GLib.SOURCE_CONTINUE

    def build_performance(self):
        group = Adw.PreferencesGroup(title="Performance mode")
        self.profile_buttons = {}
        first = None
        for choice in self.prop("PlatformProfileChoices") or []:
            label, desc = PROFILE_LABELS.get(choice, (choice.replace("-", " ").capitalize(), ""))
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first:
                check.set_group(first)
            first = first or check
            row = Adw.ActionRow(title=label, subtitle=desc, activatable_widget=check)
            row.add_prefix(check)
            check.connect("toggled", self.on_profile_toggled, choice)
            self.profile_buttons[choice] = check
            group.add(row)
        return group

    def build_battery(self):
        group = Adw.PreferencesGroup(
            title="Battery",
            description="Stop charging before full to extend battery lifespan when the laptop stays plugged in.",
        )
        self.protect_row = Adw.SwitchRow(title="Protect battery", subtitle="Limit the maximum charge level")
        self.protect_row.connect("notify::active", self.on_protect_toggled)
        group.add(self.protect_row)
        self.limit_row = Adw.SpinRow.new_with_range(50, 95, 5)
        self.limit_row.set_title("Maximum charge")
        self.limit_row.set_subtitle("Percent")
        self.limit_row.connect("notify::value", self.on_limit_changed)
        group.add(self.limit_row)
        return group

    def build_keyboard(self):
        group = Adw.PreferencesGroup(title="Keyboard")
        maximum = self.prop("KeyboardBacklightMax") or 3
        self.kbd_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, maximum, 1)
        self.kbd_scale.set_hexpand(True)
        self.kbd_scale.set_draw_value(False)
        self.kbd_scale.set_round_digits(0)
        for i in range(maximum + 1):
            self.kbd_scale.add_mark(i, Gtk.PositionType.BOTTOM, "Off" if i == 0 else str(i))
        self.kbd_scale.connect("value-changed", self.on_kbd_changed)
        row = Adw.ActionRow(title="Backlight")
        row.add_suffix(self.kbd_scale)
        group.add(row)
        return group

    def build_hardware(self, features):
        rows = [
            ("block-recording", "BlockRecording", "SetBlockRecording", "Block camera and microphone",
             "Disable recording devices at the firmware level"),
            ("usb-charging", "UsbCharging", "SetUsbCharging", "USB charging",
             "Charge devices from USB ports while the laptop is off"),
            ("power-on-lid-open", "PowerOnLidOpen", "SetPowerOnLidOpen", "Power on when lid opens",
             "Start the laptop automatically when the lid is opened"),
        ]
        self.switches = {}
        group = Adw.PreferencesGroup(title="Hardware")
        for feature, prop, method, title, subtitle in rows:
            if feature not in features:
                continue
            row = Adw.SwitchRow(title=title, subtitle=subtitle)
            row.connect("notify::active", self.on_switch_toggled, method)
            self.switches[prop] = row
            group.add(row)
        return group if self.switches else None

    # -- state sync ---------------------------------------------------------

    def sync(self):
        self.updating = True
        try:
            profile = self.prop("PlatformProfile")
            if profile in getattr(self, "profile_buttons", {}):
                self.profile_buttons[profile].set_active(True)
            threshold = self.prop("ChargeEndThreshold")
            if threshold and hasattr(self, "protect_row"):
                protected = threshold < 100
                self.protect_row.set_active(protected)
                self.limit_row.set_sensitive(protected)
                if protected:
                    self.limit_row.set_value(threshold)
            if hasattr(self, "kbd_scale"):
                self.kbd_scale.set_value(self.prop("KeyboardBacklight") or 0)
            for prop, row in getattr(self, "switches", {}).items():
                row.set_active(bool(self.prop(prop)))
        finally:
            self.updating = False

    # -- handlers -----------------------------------------------------------

    def on_profile_toggled(self, check, choice):
        if check.get_active() and not self.updating:
            self.call("SetPlatformProfile", "(s)", choice)

    def on_protect_toggled(self, row, _pspec):
        self.limit_row.set_sensitive(row.get_active())
        if self.updating:
            return
        if row.get_active():
            self.call("SetChargeEndThreshold", "(u)", int(self.limit_row.get_value()) or DEFAULT_PROTECTION_LIMIT)
        else:
            self.call("SetChargeEndThreshold", "(u)", 100)

    def on_limit_changed(self, row, _pspec):
        if self.updating or not self.protect_row.get_active():
            return
        # Debounce so holding the spin button doesn't write every step
        if self.threshold_timeout:
            GLib.source_remove(self.threshold_timeout)

        def apply():
            self.threshold_timeout = 0
            self.call("SetChargeEndThreshold", "(u)", int(row.get_value()))
            return GLib.SOURCE_REMOVE

        self.threshold_timeout = GLib.timeout_add(600, apply)

    def on_kbd_changed(self, scale):
        level = round(scale.get_value())
        if not self.updating and level != self.prop("KeyboardBacklight"):
            self.call("SetKeyboardBacklight", "(u)", level)

    def on_switch_toggled(self, row, _pspec, method):
        if not self.updating:
            self.call(method, "(b)", row.get_active())


class BudsPage(Adw.PreferencesPage):
    """Battery, noise control, equalizer and touch lock for Galaxy Buds, via galaxybudsd."""

    def __init__(self, proxy, toasts):
        super().__init__()
        self.proxy = proxy
        self.toasts = toasts
        self.updating = False

        group = Adw.PreferencesGroup()
        self.status_row = Adw.ActionRow()
        self.status_row.add_prefix(Gtk.Image(icon_name="audio-headphones-symbolic", pixel_size=32))
        self.battery_label = Gtk.Label(css_classes=["dim-label"], valign=Gtk.Align.CENTER)
        self.status_row.add_suffix(self.battery_label)
        group.add(self.status_row)
        self.add(group)

        self.controls = []
        noise = Adw.PreferencesGroup(title="Noise controls")
        self.noise_buttons = {}
        self.noise_rows = {}
        first = None
        for mode, (label, desc) in NOISE_CONTROL_LABELS.items():
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first:
                check.set_group(first)
            first = first or check
            row = Adw.ActionRow(title=label, subtitle=desc, activatable_widget=check)
            row.add_prefix(check)
            check.connect("toggled", self.on_noise_toggled, mode)
            self.noise_buttons[mode] = check
            self.noise_rows[mode] = row
            noise.add(row)
        self.add(noise)
        self.controls.append(noise)

        sound = Adw.PreferencesGroup(title="Sound and touch")
        self.eq_keys = list(EQUALIZER_LABELS)
        self.eq_row = Adw.ComboRow(title="Equalizer", model=Gtk.StringList.new(list(EQUALIZER_LABELS.values())))
        self.eq_row.connect("notify::selected", self.on_eq_selected)
        sound.add(self.eq_row)
        self.lock_row = Adw.SwitchRow(title="Lock touch controls", subtitle="Ignore taps on the earbuds")
        self.lock_row.connect("notify::active", self.on_lock_toggled)
        sound.add(self.lock_row)
        self.add(sound)
        self.controls.append(sound)

        proxy.connect("g-properties-changed", lambda *_: self.sync())
        proxy.connect("notify::g-name-owner", lambda *_: self.sync())
        self.sync()

    def prop(self, name):
        value = self.proxy.get_cached_property(name)
        return value.unpack() if value is not None else None

    def call(self, method, signature, *args):
        call_proxy(self.proxy, self.toasts, method, signature, args, self.sync)

    def sync(self):
        self.updating = True
        try:
            running = self.proxy.get_name_owner() is not None
            connected = running and bool(self.prop("Connected"))
            for group in self.controls:
                group.set_sensitive(connected)
            if not running:
                self.status_row.set_title("Galaxy Buds")
                self.status_row.set_subtitle("The galaxybudsd service is not running")
                self.battery_label.set_label("")
                return
            if not connected:
                self.status_row.set_title("Galaxy Buds")
                self.status_row.set_subtitle("Not connected. Connect the earbuds in Bluetooth settings.")
                self.battery_label.set_label("")
                return

            self.status_row.set_title(self.prop("Name") or self.prop("Model") or "Galaxy Buds")
            modes = self.prop("NoiseControlModes") or list(NOISE_CONTROL_LABELS)
            for mode, row in self.noise_rows.items():
                row.set_visible(mode in modes)
            left, right = self.prop("PlacementLeft"), self.prop("PlacementRight")
            self.status_row.set_subtitle(
                f"Left {PLACEMENT_LABELS.get(left, left)} · Right {PLACEMENT_LABELS.get(right, right)}")
            parts = []
            for label, prop in (("L", "BatteryLeft"), ("R", "BatteryRight"), ("Case", "BatteryCase")):
                level = self.prop(prop)
                if level is not None and level >= 0:
                    parts.append(f"{label} {level}%")
            self.battery_label.set_label(" · ".join(parts))

            mode = self.prop("NoiseControl")
            if mode in self.noise_buttons:
                self.noise_buttons[mode].set_active(True)
            preset = self.prop("Equalizer")
            if preset in self.eq_keys:
                self.eq_row.set_selected(self.eq_keys.index(preset))
            self.lock_row.set_active(bool(self.prop("TouchpadLocked")))
        finally:
            self.updating = False

    def on_noise_toggled(self, check, mode):
        if check.get_active() and not self.updating:
            self.call("SetNoiseControl", "(s)", mode)

    def on_eq_selected(self, row, _pspec):
        if not self.updating:
            self.call("SetEqualizer", "(s)", self.eq_keys[row.get_selected()])

    def on_lock_toggled(self, row, _pspec):
        if not self.updating:
            self.call("SetTouchpadLocked", "(b)", row.get_active())


class PhonePage(Adw.PreferencesPage):
    """Battery, file sending, screen mirroring and wireless-debugging pairing for the
    paired Galaxy phone, via galaxyphoned."""

    def __init__(self, proxy, toasts):
        super().__init__()
        self.proxy = proxy
        self.toasts = toasts

        group = Adw.PreferencesGroup()
        self.status_row = Adw.ActionRow()
        self.status_row.add_prefix(Gtk.Image(icon_name="phone-symbolic", pixel_size=32))
        self.battery_label = Gtk.Label(css_classes=["dim-label"], valign=Gtk.Align.CENTER)
        self.status_row.add_suffix(self.battery_label)
        group.add(self.status_row)
        self.add(group)

        actions = Adw.PreferencesGroup(title="Share")
        self.send_row = Adw.ActionRow(title="Send files", activatable=True)
        self.send_row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        self.send_row.connect("activated", lambda *_: self.choose_files())
        actions.add(self.send_row)
        self.mirror_row = Adw.ActionRow(title="Mirror phone screen", activatable=True)
        self.mirror_row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        self.mirror_row.connect("activated", lambda *_: call_proxy(self.proxy, self.toasts, "StartMirroring", "()", ()))
        actions.add(self.mirror_row)
        self.add(actions)

        adb = Adw.PreferencesGroup(
            title="Wireless debugging",
            description="Exact battery, notifications from every app and screen mirroring need adb. On the phone, "
                        "open Settings › Developer options › Wireless debugging › Pair device with pairing code, "
                        "then enter what it shows. Pairing is needed once.",
        )
        self.adb_row = Adw.ActionRow(title="adb")
        adb.add(self.adb_row)
        self.address_row = Adw.EntryRow(title="IP address and port")
        adb.add(self.address_row)
        self.code_row = Adw.EntryRow(title="Pairing code", input_purpose=Gtk.InputPurpose.DIGITS)
        self.pair_button = Gtk.Button(label="Pair", valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
        self.pair_button.connect("clicked", self.on_pair)
        self.code_row.add_suffix(self.pair_button)
        adb.add(self.code_row)
        self.add(adb)

        proxy.connect("g-properties-changed", lambda *_: self.sync())
        proxy.connect("notify::g-name-owner", lambda *_: self.sync())
        self.sync()

    def prop(self, name):
        value = self.proxy.get_cached_property(name)
        return value.unpack() if value is not None else None

    def sync(self):
        running = self.proxy.get_name_owner() is not None
        bluetooth, adb = running and bool(self.prop("Connected")), running and bool(self.prop("AdbConnected"))
        self.status_row.set_title((running and self.prop("Name")) or "Galaxy phone")
        if not running:
            subtitle = "The galaxyphoned service is not running"
        elif bluetooth and adb:
            subtitle = "Connected over Bluetooth and adb"
        elif bluetooth or adb:
            subtitle = f"Connected over {'Bluetooth' if bluetooth else 'adb'}"
        elif self.prop("Address"):
            subtitle = "Not connected. Turn on Bluetooth on the phone."
        else:
            subtitle = "No phone paired. Pair it in Bluetooth settings."
        self.status_row.set_subtitle(subtitle)

        level = self.prop("Battery") if running else None
        parts = []
        if level is not None and level >= 0:
            parts.append(f"{level}%" if self.prop("BatterySource") == "adb" else f"about {level}%")
            if self.prop("BatteryCharging"):
                parts.append("charging")
        self.battery_label.set_label(" · ".join(parts))

        self.send_row.set_sensitive(bluetooth or adb)
        self.send_row.set_subtitle("With adb they go to Downloads; over Bluetooth, accept them on the phone")
        can_mirror = running and bool(self.prop("CanMirror"))
        self.mirror_row.set_sensitive(can_mirror)
        self.mirror_row.set_subtitle("Opens the phone screen in a window (scrcpy)" if can_mirror
                                     else "Needs adb and scrcpy")
        self.adb_row.set_subtitle(f"Connected · {self.prop('AdbSerial')}" if adb else "Not connected")

    def choose_files(self):
        dialog = Gtk.FileDialog(title="Send files to your phone")

        def chosen(dialog, result):
            try:
                files = dialog.open_multiple_finish(result)
            except GLib.Error:
                return  # cancelled
            paths = [f.get_path() for f in files if f.get_path()]
            if paths:
                call_proxy(self.proxy, self.toasts, "SendFiles", "(as)", (paths,))

        dialog.open_multiple(self.get_root(), None, chosen)

    def on_pair(self, _button):
        address, code = self.address_row.get_text().strip(), self.code_row.get_text().strip()
        self.pair_button.set_sensitive(False)

        def done(proxy, result):
            self.pair_button.set_sensitive(True)
            try:
                proxy.call_finish(result)
            except GLib.Error as e:
                Gio.DBusError.strip_remote_error(e)
                self.toasts.add_toast(Adw.Toast(title=e.message, timeout=5))
                return
            self.code_row.set_text("")
            self.toasts.add_toast(Adw.Toast(title="Paired. The phone connects whenever wireless debugging is on."))

        self.proxy.call("AdbPair", GLib.Variant("(ss)", (address, code)), Gio.DBusCallFlags.NONE, 60000, None, done)


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.add_main_option("page", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING,
                             "Page to show: laptop, buds or phone", "PAGE")
        self.add_main_option("send-files", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
                             "Choose files to send to the phone", None)

    def do_command_line(self, command_line):
        options = command_line.get_options_dict().end().unpack()
        self.activate()
        win = self.get_active_window()
        if options.get("send-files"):
            options["page"] = "phone"
        if options.get("page") in ("laptop", "buds", "phone"):
            win.stack.set_visible_child_name(options["page"])
        if options.get("send-files") and win.phone_page:
            win.phone_page.choose_files()
        return 0

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            bus = Gio.BusType.SESSION if os.environ.get("GALAXYBOOK_BUS") == "session" else Gio.BusType.SYSTEM
            win = SettingsWindow(
                self,
                self.connect_proxy(bus, BUS_NAME, OBJECT_PATH, IFACE),
                self.connect_proxy(Gio.BusType.SESSION, BUDS_BUS_NAME, BUDS_OBJECT_PATH, BUDS_IFACE),
                self.connect_proxy(Gio.BusType.SESSION, PHONE_BUS_NAME, PHONE_OBJECT_PATH, PHONE_IFACE),
            )
        win.present()

    @staticmethod
    def connect_proxy(bus, name, path, iface):
        try:
            return Gio.DBusProxy.new_for_bus_sync(bus, Gio.DBusProxyFlags.NONE, None, name, path, iface, None)
        except GLib.Error as e:
            print(f"Could not connect to {name}: {e.message}", file=sys.stderr)
            return None


if __name__ == "__main__":
    sys.exit(SettingsApp().run(sys.argv))
